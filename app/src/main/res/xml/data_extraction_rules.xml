<?xml version="1.0" encoding="utf-8"?>
<!-- Kein Backup: der API-Key (Phase 3) wird mit einem Keystore-Schlüssel verschlüsselt, der das Gerät nicht verlässt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
